msgstr "[SORT CASES](commands/sort-cases.md)"

msgid "Sort Variables"
msgstr "Sort Variables"

msgid "puts the variables in order of name, label, type and other attributes"
msgstr "按名称、标签、类型等属性对变量排序"

msgid "[SORT VARIABLES](commands/sort-variables.md)"
msgstr "[SORT VARIABLES](commands/sort-variables.md)"

msgid "Restructure"
msgstr "Restructure"

msgid "variables to cases, cases to variables, or cases and variables swapped"
msgstr "变量转为个案、个案转为变量，或交换个案和变量"

msgid "[VARSTOCASES](commands/varstocases.md), [CASESTOVARS](commands/casestovars.md), [FLIP](commands/flip.md)"
msgstr "[VARSTOCASES](commands/varstocases.md), [CASESTOVARS](commands/casestovars.md), [FLIP](commands/flip.md)"

